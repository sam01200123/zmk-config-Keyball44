#define DEFAULT 0
#define NUM     1
#define SYM     2
#define FUN     3
#define MOUSE   4
#define SCROLL  5
#define SNIPE   6

#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

&caps_word { continue-list = <UNDERSCORE MINUS>; };

/ {
    // custom shift using mod-morph 

    macros {
        ctrl_z: ctrl_z {
            compatible = "zmk,behavior-macro";
            label = "CTRL_Z";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&macro_press &kp LCTRL>,
                       <&macro_tap &kp Z>,
                       <&macro_release &kp LCTRL>;
        };
    };

    behaviors {
        combo_hold_130: combo_hold_130 {
            compatible = "zmk,behavior-hold-tap";
            label = "COMBO_HOLD_130";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <130>;
            bindings = <&kp>, <&none>;
        };

        cmqus: comma_question {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_QUESTION";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp QUESTION>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dtsmi: dot_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_SEMI";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp SEMI>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWRT";
            bindings = <
&kp DELETE  &kp Q     &kp W     &kp E         &kp R      &kp T                 &kp Y      &kp U       &kp I             &kp O    &kp P             &kp ENTER
&kp LCTRL   &kp A     &kp S     &kp D         &kp F      &kp G                 &kp H      &kp J       &kp K             &kp L    &kp MINUS         &kp ESCAPE
&kp LSHIFT  &kp Z     &kp X     &kp C         &kp V      &kp B                 &kp N      &kp M       &kp COMMA         &kp DOT  &kp LEFT_BRACKET  &kp INT3
&kp LALT    &kp LGUI  &lt 3 BACKSPACE  &lt 4 SPACE  &mt LSHIFT TAB        &kp LANG2  &lt 2 LANG1                                          &ctrl_z
            >;
        };

        number_layer {
            label = "WIRELESS";
            bindings = <
&none  &kp N1       &kp N2       &kp N3       &kp N4       &kp N5              &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &to DEFAULT
&none  &bt BT_CLR   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &none                &none   &none   &none   &none   &none   &none
&none  &none        &none        &none        &none        &none                &none   &none   &none   &none   &none   &none
&none  &none        &none        &none        &none                         &none  &none                                &to DEFAULT
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&none   &kp LS(SQT)   &kp LS(N7)     &kp N7        &kp LS(N8)          &kp LS(N9)              &kp SLASH              &kp LS(N8)  &kp LS(N9)     &kp LS(INT1)          &kp SQT        &kp INT3
&none   &kp LS(SEMI)  &kp N4         &kp N4        &kp N5              &kp N6                  &kp NON_US_HASH        &kp LS(SLASH)  &kp LS(EQUAL)  &kp LS(N3)            &kp LS(N4)     &kp LS(N2)
&trans  &kp LS(MINUS) &kp N1         &kp LS(N1)    &kp LS(N2)          &kp N3                  &kp LS(NON_US_HASH)    &kp LS(N3)     &kp EQUAL      &kp LS(LEFT_BRACKET)  &kp LS(SLASH)  &kp LS(INT3)
&kp N0  &kp N0        &trans         &kp INT5      &kp LS(ENTER)                         &kp LC(A)  &trans                                                             &kp INT4
            >;
        };

        function_layer {
            label = "FUN";
            bindings = <
&kp LC(S)  &none  &none  &kp N7  &kp N8  &kp N9              &kp LC(F)  &kp LC(A)  &kp UP     &none      &none  &none
&trans     &none  &none  &kp N4  &kp N5  &kp N6              &none      &kp LEFT   &kp DOWN   &kp RIGHT  &none  &none
&trans     &none  &none  &kp N1  &kp N2  &kp N3              &none      &none      &none      &none      &none  &none
&trans     &kp N0 &none  &none   &none                  &kp LCTRL  &none                                &none
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&kp F1   &kp F4   &kp F7   &kp F13  &kp F14  &kp F15              &none          &none      &none     &none          &none        &none
&kp F2   &kp F5   &kp F8   &kp F16  &kp F17  &kp F18              &kp PAGE_UP    &mkp LCLK  &mkp RCLK &kp LG(LS(S)) &mo SCROLL  &mo SNIPE
&kp F3   &kp F6   &kp F9   &kp F4   &kp F7   &kp F19              &kp PAGE_DOWN  &kp LEFT   &kp DOWN  &kp RIGHT     &to NUM      &none
&kp F10  &kp F12  &trans   &trans   &trans                    &trans  &trans                                          &trans
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans              &trans  &trans                                  &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans              &trans  &trans                                  &trans
            >;
        };
    };
#include "combos.dtsi"
};
